generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  OWNER
  ADMIN
  SALES
  PRODUCTION
  QC
}

enum ProductionRoute {
  JERSEY
  NON_JERSEY
}

enum GarmentType {
  JERSEY
  NON_JERSEY
}

enum SleeveLength {
  PENDEK
  PANJANG
}

enum PurchaseOrderAttachmentKind {
  MAIN_DESIGN
  FRONT
  BACK
  LOGO_RIGHT
  LOGO_BACK
  LOGO_FRONT
  OTHER
}

enum PaymentTransactionStatus {
  ACTIVE
  VOIDED
}

enum ProductionStage {
  POTONG
  BORDIR
  SABLON
  PRINTING
  JAHIT
  QC
  PACKING
  PENGIRIMAN
  TEST_PRINT
  PERSETUJUAN_SAMPEL
  LAYOUT_PRODUKSI
  PRINT
  CUTTING
  SELESAI
}

enum ProductionWorkOrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProductionStepStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum ProductionActivityType {
  CREATED
  STAGE_MOVED
  STAGE_SKIPPED
  SAMPLE_REJECTED
  QC_REJECTED
  PIC_ASSIGNED
  NOTE_ADDED
  REOPENED
  CANCELLED
}

enum OpportunityStage {
  LEAD_BARU
  FOLLOW_UP
  NEGOSIASI
  DEAL
  LOST
}

enum DesignStatus {
  SUDAH_ADA
  BELUM_ADA
  PERLU_DIBANTU
}

enum DiscountType {
  NONE
  NOMINAL
  PERCENTAGE
}

enum PurchaseOrderStatus {
  DRAFT
  AGREED
  SUPERSEDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SUPERSEDED
}

enum PaymentKind {
  LUNAS
  DP
}

enum PaymentValueType {
  NOMINAL
  PERCENTAGE
}

enum SalesOrderStatus {
  ACTIVE
  CANCELLED
}

enum CustomerReminderType {
  REPEAT_ORDER
  REACTIVATION
}

enum CommunicationActivityKind {
  COMMUNICATION
  INTERNAL_NOTE
  SYSTEM
}

enum CommunicationChannel {
  WHATSAPP
  INSTAGRAM
  PHONE
  EMAIL
  MEETING
  OTHER
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationSystemEvent {
  STAGE_CHANGED
  PURCHASE_ORDER_AGREED
  INVOICE_ISSUED
  DEAL_ORDER_CREATED
  SALES_ORDER_CANCELLED
}

model AppUser {
  id                        String                    @id @default(cuid())
  authUserId                String                    @unique @db.Uuid
  email                     String                    @unique @db.VarChar(320)
  name                      String                    @db.VarChar(120)
  role                      AppRole
  isActive                  Boolean                   @default(true)
  mustChangePassword        Boolean                   @default(true)
  communicationActivities   CommunicationActivity[]
  customerReminderReceipts  CustomerReminderReceipt[]
  purchaseOrders            PurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  invoices                  Invoice[]                 @relation("InvoiceCreatedBy")
  dealPayments              DealPayment[]             @relation("DealPaymentCreatedBy")
  paymentTransactions       PaymentTransaction[]      @relation("PaymentTransactionCreatedBy")
  voidedPaymentTransactions PaymentTransaction[]      @relation("PaymentTransactionVoidedBy")
  salesOrders               SalesOrder[]              @relation("SalesOrderCreatedBy")
  cancelledOrders           SalesOrder[]              @relation("SalesOrderCancelledBy")
  auditEvents               AuditEvent[]
  assignedCustomers         Customer[]                @relation("CustomerSalesPic")
  assignedOpportunities     Opportunity[]             @relation("OpportunitySalesPic")
  assignedProductionSteps   ProductionStep[]          @relation("ProductionStepAssignee")
  productionActivities      ProductionActivity[]
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([role, isActive])
}

model CustomerType {
  id          String     @id @default(cuid())
  name        String     @unique @db.VarChar(80)
  description String?    @db.VarChar(500)
  position    Int        @default(0)
  isActive    Boolean    @default(true)
  customers   Customer[]
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([isActive, position, name])
}

model LeadSource {
  id            String        @id @default(cuid())
  name          String        @unique @db.VarChar(80)
  description   String?       @db.VarChar(500)
  position      Int           @default(0)
  isActive      Boolean       @default(true)
  customers     Customer[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([isActive, position, name])
}

model GarmentSize {
  id            String                     @id @default(cuid())
  name          String                     @unique @db.VarChar(40)
  description   String?                    @db.VarChar(500)
  position      Int                        @default(0)
  isActive      Boolean                    @default(true)
  purchaseRows  PurchaseOrderSize[]
  rosterEntries PurchaseOrderRosterEntry[]
  invoiceItems  InvoiceItem[]
  createdAt     DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([isActive, position, name])
}

model BusinessProfile {
  id        String   @id @default("default") @db.VarChar(32)
  name      String   @db.VarChar(160)
  phone     String?  @db.VarChar(32)
  email     String?  @db.VarChar(320)
  address   String?  @db.Text
  logoPath  String?  @db.VarChar(500)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Customer {
  id                      String                  @id @default(cuid())
  customerNo              String                  @unique @db.VarChar(24)
  name                    String                  @db.VarChar(160)
  companyName             String?                 @db.VarChar(160)
  whatsapp                String?                 @db.VarChar(32)
  email                   String?                 @db.VarChar(320)
  instagram               String?                 @db.VarChar(80)
  address                 String?                 @db.Text
  city                    String?                 @db.VarChar(120)
  notes                   String?                 @db.Text
  customerTypeId          String
  leadSourceId            String?
  salesPicId              String?
  archivedAt              DateTime?               @db.Timestamptz(3)
  version                 Int                     @default(1)
  customerType            CustomerType            @relation(fields: [customerTypeId], references: [id], onDelete: Restrict)
  leadSource              LeadSource?             @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  salesPic                AppUser?                @relation("CustomerSalesPic", fields: [salesPicId], references: [id], onDelete: SetNull)
  opportunities           Opportunity[]
  communicationActivities CommunicationActivity[]
  reminders               CustomerReminder[]
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)

  @@index([archivedAt, updatedAt])
  @@index([name])
  @@index([companyName])
  @@index([customerTypeId, archivedAt])
  @@index([leadSourceId])
  @@index([salesPicId])
  @@index([city])
}

model Opportunity {
  id                      String                  @id @default(cuid())
  opportunityNo           String                  @unique @db.VarChar(24)
  customerId              String
  title                   String                  @db.VarChar(180)
  stage                   OpportunityStage        @default(LEAD_BARU)
  leadSourceId            String?
  salesPicId              String?
  productName             String?                 @db.VarChar(120)
  garmentType             GarmentType?
  needPurpose             String?                 @db.VarChar(500)
  designStatus            DesignStatus?
  specification           String?                 @db.Text
  customerBudget          Decimal?                @db.Decimal(18, 2)
  leadScore               Int                     @default(0)
  estimatedQuantity       Int?
  estimatedValue          Decimal?                @db.Decimal(18, 2)
  deadline                DateTime?               @db.Date
  lastContactedAt         DateTime?               @db.Timestamptz(3)
  nextAction              String?                 @db.VarChar(500)
  nextActionAt            DateTime?               @db.Timestamptz(3)
  publicSubmissionKey     String?                 @unique @db.Uuid
  cancelReason            String?                 @db.Text
  version                 Int                     @default(1)
  customer                Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  leadSource              LeadSource?             @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  salesPic                AppUser?                @relation("OpportunitySalesPic", fields: [salesPicId], references: [id], onDelete: SetNull)
  communicationActivities CommunicationActivity[]
  purchaseOrders          PurchaseOrder[]
  invoices                Invoice[]
  salesOrders             SalesOrder[]
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)

  @@index([customerId, updatedAt])
  @@index([stage, updatedAt])
  @@index([salesPicId, stage])
  @@index([salesPicId, nextActionAt])
  @@index([leadSourceId, createdAt])
  @@index([leadScore, stage])
}

model PublicRateLimitBucket {
  key         String   @id @db.VarChar(64)
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}

model CommunicationActivity {
  id                 String                    @id @default(cuid())
  customerId         String
  opportunityId      String?
  authorId           String
  kind               CommunicationActivityKind
  channel            CommunicationChannel?
  direction          CommunicationDirection?
  systemEvent        CommunicationSystemEvent?
  content            String                    @db.Text
  metadata           Json?
  occurredAt         DateTime                  @db.Timestamptz(3)
  sourceAuditEventId String?                   @unique
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunity        Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  author             AppUser                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sourceAuditEvent   AuditEvent?               @relation("CommunicationActivityAuditEvent", fields: [sourceAuditEventId], references: [id], onDelete: Restrict)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)

  @@index([customerId, occurredAt, id])
  @@index([opportunityId, occurredAt, id])
  @@index([authorId, occurredAt])
}

model PurchaseOrder {
  id                       String                     @id @default(cuid())
  purchaseOrderNo          String                     @unique @db.VarChar(28)
  customerReference        String?                    @db.VarChar(120)
  opportunityId            String
  revision                 Int
  status                   PurchaseOrderStatus        @default(DRAFT)
  productName              String                     @db.VarChar(120)
  garmentType              GarmentType?
  material                 String                     @db.VarChar(120)
  color                    String?                    @db.VarChar(120)
  baseColor                String?                    @db.VarChar(120)
  variationColor           String?                    @db.VarChar(240)
  decorationMethod         String?                    @db.VarChar(120)
  orderDate                DateTime?                  @db.Date
  sampleSize               String?                    @db.VarChar(40)
  designNotes              String?                    @db.Text
  notes                    String?                    @db.Text
  deadline                 DateTime?                  @db.Date
  agreedAt                 DateTime?                  @db.Timestamptz(3)
  snapshotBusinessName     String?                    @db.VarChar(160)
  snapshotBusinessPhone    String?                    @db.VarChar(32)
  snapshotBusinessEmail    String?                    @db.VarChar(320)
  snapshotBusinessAddress  String?                    @db.Text
  snapshotBusinessLogoPath String?                    @db.VarChar(500)
  version                  Int                        @default(1)
  createdById              String
  opportunity              Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  createdBy                AppUser                    @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sizes                    PurchaseOrderSize[]
  rosterEntries            PurchaseOrderRosterEntry[]
  attachments              PurchaseOrderAttachment[]
  invoices                 Invoice[]
  salesOrder               SalesOrder?
  createdAt                DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @db.Timestamptz(3)

  @@unique([opportunityId, revision])
  @@index([opportunityId, status])
  @@index([createdById, createdAt])
}

model PurchaseOrderSize {
  id              String        @id @default(cuid())
  purchaseOrderId String
  position        Int
  sizeId          String?
  size            String        @db.VarChar(40)
  sleeveLength    SleeveLength  @default(PANJANG)
  quantity        Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  garmentSize     GarmentSize?  @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, position])
  @@unique([purchaseOrderId, sleeveLength, size])
  @@index([purchaseOrderId])
  @@index([sizeId])
}

model PurchaseOrderRosterEntry {
  id              String        @id @default(cuid())
  purchaseOrderId String
  position        Int
  memberId        String        @db.VarChar(80)
  name            String        @db.VarChar(160)
  sizeId          String?
  size            String        @db.VarChar(40)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  garmentSize     GarmentSize?  @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, position])
  @@unique([purchaseOrderId, memberId])
  @@index([purchaseOrderId, size])
  @@index([sizeId])
}

model PurchaseOrderAttachment {
  id              String                      @id @default(cuid())
  purchaseOrderId String
  path            String                      @db.VarChar(500)
  originalName    String                      @db.VarChar(255)
  contentType     String                      @db.VarChar(64)
  sizeBytes       Int
  kind            PurchaseOrderAttachmentKind @default(OTHER)
  caption         String?                     @db.VarChar(160)
  purchaseOrder   PurchaseOrder               @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)

  @@index([purchaseOrderId, createdAt])
}

model Invoice {
  id                       String        @id @default(cuid())
  invoiceNo                String        @unique @db.VarChar(28)
  opportunityId            String
  purchaseOrderId          String
  revision                 Int
  status                   InvoiceStatus @default(DRAFT)
  snapshotCustomerName     String        @db.VarChar(160)
  snapshotCompanyName      String?       @db.VarChar(160)
  snapshotWhatsapp         String?       @db.VarChar(32)
  snapshotEmail            String?       @db.VarChar(320)
  snapshotInstagram        String?       @db.VarChar(80)
  snapshotAddress          String?       @db.Text
  snapshotBusinessName     String?       @db.VarChar(160)
  snapshotBusinessPhone    String?       @db.VarChar(32)
  snapshotBusinessEmail    String?       @db.VarChar(320)
  snapshotBusinessAddress  String?       @db.Text
  snapshotBusinessLogoPath String?       @db.VarChar(500)
  discountType             DiscountType  @default(NONE)
  discountValue            Decimal       @default(0) @db.Decimal(18, 2)
  subtotal                 Decimal       @db.Decimal(18, 2)
  totalDiscount            Decimal       @default(0) @db.Decimal(18, 2)
  totalTax                 Decimal       @default(0) @db.Decimal(18, 2)
  total                    Decimal       @db.Decimal(18, 2)
  issuedAt                 DateTime?     @db.Timestamptz(3)
  dueAt                    DateTime?     @db.Date
  notes                    String?       @db.Text
  version                  Int           @default(1)
  createdById              String
  opportunity              Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  purchaseOrder            PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy                AppUser       @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items                    InvoiceItem[]
  salesOrder               SalesOrder?
  createdAt                DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([opportunityId, revision])
  @@index([opportunityId, status])
  @@index([purchaseOrderId, status])
  @@index([createdById, createdAt])
}

model InvoiceItem {
  id                String        @id @default(cuid())
  invoiceId         String
  position          Int
  productName       String?       @db.VarChar(120)
  sizeId            String?
  size              String        @db.VarChar(40)
  sleeveLength      SleeveLength?
  description       String        @db.VarChar(240)
  quantity          Int
  unitPrice         Decimal       @db.Decimal(18, 2)
  grossAmount       Decimal       @default(0) @db.Decimal(18, 2)
  discountPercent   Decimal       @default(0) @db.Decimal(7, 4)
  discountCapAmount Decimal?      @db.Decimal(18, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(18, 2)
  taxRate           Decimal       @default(0) @db.Decimal(7, 4)
  taxAmount         Decimal       @default(0) @db.Decimal(18, 2)
  total             Decimal       @default(0) @db.Decimal(18, 2)
  subtotal          Decimal       @db.Decimal(18, 2)
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  garmentSize       GarmentSize?  @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@index([sizeId])
}

model SalesOrder {
  id                   String               @id @default(cuid())
  salesOrderNo         String               @unique @db.VarChar(28)
  opportunityId        String
  purchaseOrderId      String               @unique
  invoiceId            String               @unique
  purchaseOrderNo      String               @db.VarChar(28)
  invoiceNo            String               @db.VarChar(28)
  status               SalesOrderStatus     @default(ACTIVE)
  snapshotCustomerName String               @db.VarChar(160)
  snapshotCompanyName  String?              @db.VarChar(160)
  snapshotWhatsapp     String?              @db.VarChar(32)
  snapshotEmail        String?              @db.VarChar(320)
  snapshotInstagram    String?              @db.VarChar(80)
  snapshotAddress      String?              @db.Text
  discountType         DiscountType
  discountValue        Decimal              @db.Decimal(18, 2)
  subtotal             Decimal              @db.Decimal(18, 2)
  total                Decimal              @db.Decimal(18, 2)
  acceptedAt           DateTime             @db.Timestamptz(3)
  createdById          String
  cancelledAt          DateTime?            @db.Timestamptz(3)
  cancelReason         String?              @db.Text
  cancelledById        String?
  opportunity          Opportunity          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  purchaseOrder        PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  invoice              Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy            AppUser              @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy          AppUser?             @relation("SalesOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items                SalesOrderItem[]
  payment              DealPayment?
  customerReminders    CustomerReminder[]   @relation("CustomerReminderSourceOrder")
  productionWorkOrder  ProductionWorkOrder?
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)

  @@index([opportunityId, status])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model ProductionWorkOrder {
  id                String                    @id @default(cuid())
  workOrderNo       String                    @unique @db.VarChar(28)
  salesOrderId      String                    @unique
  route             ProductionRoute
  productName       String                    @db.VarChar(160)
  quantity          Int
  deadline          DateTime                  @db.Date
  stageSequence     ProductionStage[]
  currentStage      ProductionStage
  status            ProductionWorkOrderStatus @default(ACTIVE)
  sampleRevision    Int                       @default(1)
  needsRepair       Boolean                   @default(false)
  repairReason      String?                   @db.Text
  repairRequestedAt DateTime?                 @db.Timestamptz(3)
  version           Int                       @default(1)
  completedAt       DateTime?                 @db.Timestamptz(3)
  cancelledAt       DateTime?                 @db.Timestamptz(3)
  salesOrder        SalesOrder                @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  steps             ProductionStep[]
  activities        ProductionActivity[]
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([route, status, updatedAt])
  @@index([currentStage, status, updatedAt])
  @@index([deadline, status])
}

model ProductionStep {
  id           String               @id @default(cuid())
  workOrderId  String
  stage        ProductionStage
  position     Int
  status       ProductionStepStatus @default(PENDING)
  assigneeId   String?
  attemptCount Int                  @default(0)
  startedAt    DateTime?            @db.Timestamptz(3)
  completedAt  DateTime?            @db.Timestamptz(3)
  workOrder    ProductionWorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  assignee     AppUser?             @relation("ProductionStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([workOrderId, stage])
  @@unique([workOrderId, position])
  @@index([assigneeId, status])
}

model ProductionActivity {
  id          String                 @id @default(cuid())
  workOrderId String
  actorId     String
  type        ProductionActivityType
  fromStage   ProductionStage?
  toStage     ProductionStage?
  note        String?                @db.Text
  metadata    Json?
  workOrder   ProductionWorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor       AppUser                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)

  @@index([workOrderId, createdAt, id])
  @@index([actorId, createdAt])
}

model DealPayment {
  id                String               @id @default(cuid())
  salesOrderId      String               @unique
  kind              PaymentKind
  paidAt            DateTime             @db.Timestamptz(3)
  initialValueType  PaymentValueType
  initialValue      Decimal              @db.Decimal(18, 2)
  initialAmount     Decimal              @db.Decimal(18, 2)
  outstandingAmount Decimal              @db.Decimal(18, 2)
  createdById       String
  salesOrder        SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy         AppUser              @relation("DealPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  terms             PaymentTerm[]
  transactions      PaymentTransaction[]
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)

  @@index([createdById, createdAt])
}

model PaymentTerm {
  id           String               @id @default(cuid())
  paymentId    String
  position     Int
  valueType    PaymentValueType
  value        Decimal              @db.Decimal(18, 2)
  amount       Decimal              @db.Decimal(18, 2)
  dueAt        DateTime             @db.Date
  payment      DealPayment          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[] @relation("PaymentTermTransactions")

  @@unique([id, paymentId])
  @@unique([paymentId, position])
  @@index([paymentId, dueAt])
}

model PaymentTransaction {
  id            String                   @id @default(cuid())
  paymentId     String
  paymentTermId String?
  amount        Decimal                  @db.Decimal(18, 2)
  paidAt        DateTime                 @db.Timestamptz(3)
  reference     String?                  @db.VarChar(120)
  note          String?                  @db.VarChar(1000)
  status        PaymentTransactionStatus @default(ACTIVE)
  createdById   String
  voidedAt      DateTime?                @db.Timestamptz(3)
  voidReason    String?                  @db.VarChar(1000)
  voidedById    String?
  payment       DealPayment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentTerm   PaymentTerm?             @relation("PaymentTermTransactions", fields: [paymentTermId, paymentId], references: [id, paymentId], onDelete: Restrict)
  createdBy     AppUser                  @relation("PaymentTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy      AppUser?                 @relation("PaymentTransactionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)

  @@index([paymentId, status, paidAt])
  @@index([paymentTermId, status])
  @@index([createdById, createdAt])
}

model SalesOrderItem {
  id                String        @id @default(cuid())
  salesOrderId      String
  position          Int
  productName       String?       @db.VarChar(120)
  size              String        @db.VarChar(40)
  sleeveLength      SleeveLength?
  description       String        @db.VarChar(240)
  quantity          Int
  unitPrice         Decimal       @db.Decimal(18, 2)
  grossAmount       Decimal       @default(0) @db.Decimal(18, 2)
  discountPercent   Decimal       @default(0) @db.Decimal(7, 4)
  discountCapAmount Decimal?      @db.Decimal(18, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(18, 2)
  taxRate           Decimal       @default(0) @db.Decimal(7, 4)
  taxAmount         Decimal       @default(0) @db.Decimal(18, 2)
  total             Decimal       @default(0) @db.Decimal(18, 2)
  subtotal          Decimal       @db.Decimal(18, 2)
  salesOrder        SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, position])
  @@index([salesOrderId])
}

model CustomerReminder {
  id                 String                    @id @default(cuid())
  customerId         String
  sourceSalesOrderId String
  type               CustomerReminderType
  dueAt              DateTime                  @db.Timestamptz(3)
  resolvedAt         DateTime?                 @db.Timestamptz(3)
  generation         Int                       @default(1)
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceSalesOrder   SalesOrder                @relation("CustomerReminderSourceOrder", fields: [sourceSalesOrderId], references: [id], onDelete: Restrict)
  receipts           CustomerReminderReceipt[]
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)

  @@unique([sourceSalesOrderId, type])
  @@index([resolvedAt, dueAt])
  @@index([customerId, resolvedAt, dueAt])
}

model CustomerReminderReceipt {
  id         String           @id @default(cuid())
  reminderId String
  actorId    String
  readAt     DateTime         @default(now()) @db.Timestamptz(3)
  reminder   CustomerReminder @relation(fields: [reminderId], references: [id], onDelete: Restrict)
  actor      AppUser          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([reminderId, actorId])
  @@index([actorId, readAt])
}

model AuditEvent {
  id                    String                 @id @default(cuid())
  actorId               String
  entityType            String                 @db.VarChar(64)
  entityId              String
  action                String                 @db.VarChar(80)
  changedFields         String[]
  metadata              Json?
  actor                 AppUser                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  communicationActivity CommunicationActivity? @relation("CommunicationActivityAuditEvent")
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model SequenceCounter {
  key       String   @id @db.VarChar(64)
  value     Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
