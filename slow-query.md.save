| SELECT<br>  e.name,<br>  n.nspname AS schema,<br>  e.default_version,<br>  x.extversion AS installed_version,<br>  e.comment,<br>  ev.schema AS default_version_schema<br>FROM<br>  pg_available_extensions e<br>  LEFT JOIN pg_extension x ON e.name = x.extname<br>  LEFT JOIN pg_namespace n ON x.extnamespace = n.oid<br>  LEFT JOIN pg_available_extension_versions ev<br>    ON ev.name = e.name AND ev.version = e.default_version                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     