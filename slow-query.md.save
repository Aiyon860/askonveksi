| WITH candidate AS (<br>      SELECT "id" FROM "WhatsAppAutomationJob"<br>      WHERE ("status" = $2 OR ("status" = $3 AND COALESCE("nextAttemptAt", "scheduledAt") <= NOW()) OR ("status" = $4 AND "leaseExpiresAt" < NOW()))<br>        AND "scheduledAt" <= NOW()<br>      ORDER BY "scheduledAt", "id"<br>      FOR UPDATE SKIP LOCKED LIMIT $5<br>    )<br>    UPDATE "WhatsAppAutomationJob" job SET "status" = $6, "leaseOwner" = $1, "leaseExpiresAt" = NOW() + INTERVAL $7, "attempts" = "attempts" + $8, "updatedAt" = NOW()<br>    FROM candidate WHERE job."id" = candidate."id" RETURNING job."id"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                