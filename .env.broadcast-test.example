# PostgreSQL lokal kosong; database harus bernama persis askonveksi_broadcast_test.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/askonveksi_broadcast_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/askonveksi_broadcast_test

# Login tetap memakai akun Supabase yang sudah ada. Jangan gunakan service-role key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
BROADCAST_TEST_AUTH_USER_ID=00000000-0000-4000-8000-000000000000
BROADCAST_TEST_USER_EMAIL=your-existing-login@example.com
BROADCAST_TEST_USER_NAME=Broadcast Test Developer

# Tepat dua nomor WhatsApp yang Anda kontrol, dipisahkan koma.
BROADCAST_TEST_RECIPIENTS=6281111111111,6281222222222
WHATSAPP_AUTH_PATH=.data/baileys-auth-broadcast-test
WHATSAPP_TIMEZONE=Asia/Jakarta
WHATSAPP_WORKER_ID=broadcast-test-worker
WHATSAPP_WORKER_SECRET=replace-with-at-least-32-random-characters
WHATSAPP_HEALTH_PORT=3002
WHATSAPP_MEDIA_BUCKET=whatsapp-media
